{
  "name": "chalao",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare:apps": "node scripts/prepare-apps.js",
    "build:all": "next build && node scripts/prepare-apps.js",
    "rider:sync": "cd apps/rider && pnpm exec cap sync",
