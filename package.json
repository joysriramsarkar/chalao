    "rider:ios": "cd apps/rider && pnpm exec cap open ios",
    "driver:sync": "cd apps/driver && pnpm exec cap sync",
    "driver:android": "cd apps/driver && pnpm exec cap open android",
    "driver:ios": "cd apps/driver && pnpm exec cap open ios",
    "admin:sync": "cd apps/admin && pnpm exec cap sync",
    "admin:android": "cd apps/admin && pnpm exec cap open android",
    "admin:ios": "cd apps/admin && pnpm exec cap open ios",
    "cap:sync": "pnpm exec cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.1",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/cli": "^7.0.1",
    "@capacitor/core": "^7.0.1",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.1",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
