# Chalao — environment variables
# Copy to .env.local for development. Never commit real secrets.

# Neon PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# JWT signing key — at least 32 characters (required in production)
JWT_SECRET=replace-with-a-long-random-string-min-32-chars

# Admin console credentials (required in production; dev falls back to admin/echo123)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Echo the generated OTP in the API response and accept 123456.
# Defaults to true outside production and false in production.
CHALAO_DEV_OTP=false

# SMS gateway key. Without it (and with CHALAO_DEV_OTP=false) send-otp returns 503.
SMS_API_KEY=

# Base URL of the API for static/Capacitor builds, e.g. https://chalao.vercel.app/api
# Leave empty for same-origin web deployments.
NEXT_PUBLIC_API_BASE_URL=
